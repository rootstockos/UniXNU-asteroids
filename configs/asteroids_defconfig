# PROPOSAL: kernel configuration for the first XNU boot of the Nothing Phone (3a) (asteroids). Rename to
# asteroids_defconfig to use it ("unixnu defconfig" only lists *_defconfig). CONFIG_XNU_<NAME> becomes XNU_<NAME> for
# the kernel build.
#
# Goal: XNU to the framebuffer console and the platform expert, no root. This is sheng's configuration reduced to the
# platform, CPU and source-crypto core, which is close to uke's first-console configuration (that one reached the XNU
# entry on SM7675). Every archive a CONFIG below links is made by one entry of [kernel] archives in
# proposed-board-sections.toml, and no CONFIG needs a sheng-only module or an archive supplied from outside.

# Kept: run the [kernel] archives builders before the link. Without it the link finds no ArmDTPlatform, ArmCpu or
# corecrypto archive.
CONFIG_XNU_BUILD_ARCHIVES=y

# Kept: source corecrypto provider. ArmCpu requires it.
# Archive: build/corecrypto-2023/libcorecrypto_kernel_noasm-namespaced.a (build-corecrypto-14.py, then --namespace)
CONFIG_XNU_SOURCE_CORECRYPTO14=y
# Kept: the original corecrypto kext (a prelink root) initializes through real OSKext startup, as on sheng.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# Kept: Apple-format device tree platform expert, the goal of this boot.
# Archive: build/armdt-platform/libArmDTPlatform.a (build-arm-driver.py ArmDTPlatform)
CONFIG_XNU_ARM_DT_PLATFORM=y
# Kept: architectural CPU, GICv3 and IPI provider. Needs SOURCE_CORECRYPTO14 and a platform expert, both set.
# Archive: build/armcpu/libArmCpu.a (build-arm-driver.py ArmCpu)
CONFIG_XNU_ARMCPU=y

# Added after the first boot (2026-10-22): XNU panicked "pthread kernel extension not loaded (function table is
# NULL) @pthread_shims.c:318". The kernel registers pthread at early boot, long before launchd, so the source
# component is needed for any boot.
# Archive: build/libpthread-kernel/libpthread_kernel.a (build-libpthread-kernel.py)
CONFIG_XNU_SOURCE_PTHREAD=y

# Added after the second boot (2026-10-22): the unchanged AMFI panicked "AMFI: No PMGR?" (ConfigurationSettings.cpp:235).
# sheng's placeholder ApplePMGR provider, no hardware access; runs with the boot argument sheng-pmgr=2.
# Archive: build/sheng-platform-power/libShengPlatformPower.a (build-asteroids-platform-power.py)
CONFIG_XNU_SHENG_PMGR=y

# UFS step 1 (2026-10-22): NativeUfs for the read-only probe native-ufs-probe=10, built without the verified root.
# Archive: build/native-ufs/libNativeUfs.a (build-arm-driver.py NativeUfs)
CONFIG_XNU_NATIVE_UFS=y
# UFS root, step 2 (2026-10-23), as uke-full_defconfig: the Data volume and its AES dependency, and mockfs.
# Archives: build/native-aes/libNativeAES.a, build/native-ram-block/libNativeRamBlock.a, the mockfs fixture.
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_SOURCE_MOCKFS=y

# Kept, no archive: generic kernel changes that sheng, fajita and uke all build with. (The defconfig parser takes no
# comment after a value, so each reason is on the line above.)
# Architectural timer entry (19.2 MHz, as sheng); needs ARMCPU.
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# ARMv8.1 PAN; the SM7635 cores (ARMv9.2) have it.
CONFIG_XNU_NATIVE_PAN=y
# Panic region from the device tree; harmless without one.
CONFIG_XNU_DT_PANIC_REGION=y
# Trust cache runtime init on BCM2837; part of the qualified AMFI path.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
# 4 KiB code signature hashes derived from verified 16 KiB blocks; needed once signed code runs.
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y

# Kept explicit off, as in sheng: the prototype mobile display and the QEMU virt platform.
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

# Dropped (off), with the reason. "# ... is not set" makes the choice explicit in the configuration.
#
# Not needed: the PGZ allocator probe (offline test case only).
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
#
# Storage: VirtioBlock has no device.
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
#
# Owner root and Data chain: needs the verified-root and verified VirtIO bundles that no builder makes ("they need the
# volume policies of the target image", sheng board.toml) and a root. All follow from VERIFIED_ROOT_PROBE. The two
# *_ARCHIVE strings must go too: kernel.py refuses the build when a CONFIG_XNU_*_ARCHIVE names a missing .a, even
# with its feature off. OWNER_DATA_VOLUME_UUID is the UUID of sheng's Data seed and is read only with OWNER_DATA_MOUNT.
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# CONFIG_XNU_OWNER_ROOT_AUDIT is not set
# CONFIG_XNU_OWNER_ROOT_TRUST is not set
# CONFIG_XNU_OWNER_CACHE_MOUNT is not set
# CONFIG_XNU_OWNER_CACHE_STARTUP is not set
# CONFIG_XNU_OWNER_BOOT_MANIFEST is not set
# CONFIG_XNU_OWNER_DATA_MOUNT is not set
# CONFIG_XNU_OWNER_UNION_SYSTEMOS is not set
#
# Boot progress: the kit is sheng's package (kits/sheng/BootProgress.c), and the base build refuses it without UFS,
# owner-root audit and VirtIO.
# CONFIG_XNU_BOOT_PROGRESS is not set
#
# Display and GPU: the legacy display is the CPU-rendered SpringBoard display (a sheng device script, and it excludes
# -v); NativeAdreno knows only the Adreno 740.
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set

